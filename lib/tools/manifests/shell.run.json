{
  "id": "shell.run",
  "name": "shell.run",
  "display_name": "Shell Run (safe)",
  "category": "shell",
  "provider": "builtin",
  "version": "1.0.0",
  "capabilities": ["shell_exec", "shell.run"],
  "permissions": ["shell"],
  "risk": {"default": "HIGH"},
  "execution": {"mode": "sandbox", "timeout": 120},
  "input_schema": {
    "type": "object",
    "required": ["command"],
    "properties": {
      "command": {"type": "string"},
      "cwd": {"type": "string"},
      "timeout": {"type": "integer", "default": 60},
      "env": {"type": "object"}
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "stdout": {"type": "string"},
      "stderr": {"type": "string"},
      "exit_code": {"type": "integer"},
      "denied": {"type": "boolean"}
    }
  }
}
