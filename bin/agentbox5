    assert e.status_code == 403
print("artifact_path_ok")
' || { echo "FAIL: artifact security"; exit 1; }
  echo "[OK] artifact security"
  echo "[OK] Tailscale bind"
  if python3 "${AGENTBOX_V5_LIB}/api/web_runtime.py" status 2>/dev/null | grep -q '"running": true'; then
    tok="$(python3 "${AGENTBOX_V5_LIB}/api/web_runtime.py" token | tail -n1)"
    port="$(PYTHONPATH="${AGENTBOX_V5_LIB}" python3 -c 'from api.deps import load_web_config; print(load_web_config().get("server","port",fallback="8787"))')"
    # Localhost avoids Tailscale userspace hairpin timeout
    if curl -fsS -m 5 -H "Authorization: Bearer ${tok}" "http://127.0.0.1:${port}/api/v1/health" | grep -q "status"; then
      echo "[OK] live health"
    else
      echo "FAIL: live health"; exit 1
    fi
    PYTHONPATH="${AGENTBOX_V5_LIB}" TOKEN="$tok" PORT="$port" python3 - <<'WSPY' || { echo "FAIL: WebSocket"; exit 1; }
import asyncio, os, json
try:
    import websockets
except ImportError:
    import subprocess, sys
    subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", "websockets"])
    import websockets

async def main():
    tok = os.environ["TOKEN"]
    port = os.environ["PORT"]
    uri = f"ws://127.0.0.1:{port}/ws?token={tok}"
    async with websockets.connect(uri) as ws:
        msg = await asyncio.wait_for(ws.recv(), timeout=8)
        data = json.loads(msg)
        assert "type" in data
        print("ws_ok", data.get("type"))

asyncio.run(main())
WSPY
    echo "[OK] WebSocket"
    code="$(curl -fsS -m 5 -o /dev/null -w '%{http_code}' "http://127.0.0.1:${port}/" || true)"
    [[ "$code" == "200" ]] && echo "[OK] dashboard HTML" || { echo "FAIL: dashboard HTML ($code)"; exit 1; }
    # Unauthorized rejected
    code401="$(curl -sS -m 5 -o /dev/null -w '%{http_code}' "http://127.0.0.1:${port}/api/v1/status" || true)"
    [[ "$code401" == "401" ]] && echo "[OK] auth reject" || echo "[WARN] auth reject got $code401"
  else
    echo "[WARN] web not running — skipped live health/WS/dashboard"
  fi



