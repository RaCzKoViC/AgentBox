  echo "OK: recover --dry-run"
  python3 "${AGENTBOX_V5_LIB}/ops/maintenance.py" enter selftest >/dev/null
  python3 -c 'import os,sys; sys.path.insert(0,os.environ["AGENTBOX_V5_LIB"]); from ops.maintenance import is_maintenance; assert is_maintenance()'
  python3 "${AGENTBOX_V5_LIB}/ops/maintenance.py" exit >/dev/null
  echo "OK: maintenance enter/exit"
  python3 "${AGENTBOX_V5_LIB}/ops/retention.py" prune --dry-run >/dev/null
  echo "OK: retention dry-run"
  python3 "${AGENTBOX_V5_LIB}/ops/diagnostics.py" doctor >/dev/null || true
  echo "OK: doctor"
  python3 "${AGENTBOX_V5_LIB}/ops/security_hardening.py" >/dev/null
  echo "OK: security hardening checks"
