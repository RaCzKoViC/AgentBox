        rotate) python3 "${AGENTBOX_V5_LIB}/api/web_runtime.py" rotate-token ;;
        *) echo "usage: agent5 auth token [show|rotate]" >&2; return 2 ;;
      esac
      ;;
    sessions)
      PYTHONPATH="${AGENTBOX_V5_LIB}" python3 -c 'import json; from api.auth import list_sessions; from api.deps import db_connect; c=db_connect(); print(json.dumps(list_sessions(c), indent=2)); c.close()'
      ;;
    revoke)
      local sid="${1:-}"
      [[ -n "$sid" ]] || { echo "usage: agent5 auth revoke SESSION_ID" >&2; return 2; }
      SESSION_ID="$sid" PYTHONPATH="${AGENTBOX_V5_LIB}" python3 -c 'import os,json; from api.auth import revoke_session; from api.deps import db_connect; c=db_connect(); print(json.dumps({"ok": revoke_session(c, os.environ["SESSION_ID"])})); c.close()'
      ;;
    *) echo "usage: agent5 auth token|sessions|revoke ID" >&2; return 2 ;;
  esac
}


cmd_backup() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    create) python3 "${AGENTBOX_V5_LIB}/ops/backups.py" create "$@" ;;
    list) python3 "${AGENTBOX_V5_LIB}/ops/backups.py" list ;;
    inspect)
      [[ -n "${1:-}" ]] || { echo "usage: agent5 backup inspect BACKUP_ID" >&2; return 2; }
      python3 "${AGENTBOX_V5_LIB}/ops/backups.py" inspect "$1"
      ;;
    verify)
      [[ -n "${1:-}" ]] || { echo "usage: agent5 backup verify BACKUP_ID" >&2; return 2; }
      python3 "${AGENTBOX_V5_LIB}/ops/backups.py" verify "$1"
      ;;
    prune) python3 "${AGENTBOX_V5_LIB}/ops/backups.py" prune ;;
    export)
      [[ -n "${1:-}" && -n "${2:-}" ]] || { echo "usage: agent5 backup export BACKUP_ID DEST" >&2; return 2; }
      python3 "${AGENTBOX_V5_LIB}/ops/backups.py" export "$1" "$2"
      ;;
    *) echo "usage: agent5 backup create|list|inspect|verify|prune|export" >&2; return 2 ;;
  esac
}

