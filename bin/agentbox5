cmd_worktree() {
  local sub="${1:-audit}"; shift || true
  ab5_ensure_env
  case "$sub" in
    audit)
      python3 -c '
import json, os, sys
sys.path.insert(0, os.environ["AGENTBOX_V5_LIB"])
from ops.recovery import scan_orphan_worktrees
print(json.dumps({"worktrees": scan_orphan_worktrees()}, indent=2))
'
      ;;
    prune)
      # respect auto_cleanup flag — force only with --force
      if [[ "${1:-}" == "--force" ]]; then
        python3 -c '
import json, os, sys, shutil
from pathlib import Path
sys.path.insert(0, os.environ["AGENTBOX_V5_LIB"])
from ops.recovery import scan_orphan_worktrees
removed=[]
for w in scan_orphan_worktrees():
    if w.get("category")=="safe_to_remove":
        shutil.rmtree(w["path"], ignore_errors=True)
        removed.append(w["task_id"])
print(json.dumps({"removed": removed}, indent=2))
'
      else:
        echo "worktree prune requires --force (and only removes safe_to_remove); default auto_cleanup_orphan_worktrees=false" >&2
        return 2
      fi
      ;;
    *) echo "usage: agent5 worktree audit|prune --force" >&2; return 2 ;;
  esac
}



cmd_worker() {
  local sub="${1:-}"; shift || true
  export PYTHONPATH="${AGENTBOX_V5_LIB}${PYTHONPATH:+:$PYTHONPATH}"
  case "$sub" in
    list)
      python3 - <<'PY'
import json
from distributed import registry
registry.mark_offline_stale()
items = registry.list_workers()
print(json.dumps({"items": items, "counts": registry.counts()}, indent=2))
for w in items:
    print(f"{w['id']}\t{w.get('name')}\t{w.get('status')}\t{w.get('hostname')}\tload={w.get('current_load')}", file=__import__("sys").stderr)
PY
      ;;
    show)
      local wid="${1:-}"
      [[ -n "$wid" ]] || { echo "usage: agent5 worker show WORKER_ID" >&2; return 2; }
      WORKER_ID="$wid" python3 - <<'PY'
import json, os
from distributed import registry
w = registry.get_worker(os.environ["WORKER_ID"])
if not w:
    raise SystemExit("worker not found")
print(json.dumps(w, indent=2))
PY
      ;;
    token)
      local tsub="${1:-create}"; shift || true
      case "$tsub" in
        create)
          python3 - <<'PY'
import json
from distributed import enrollment
print(json.dumps(enrollment.create_enrollment_token(), indent=2))
PY
          ;;
        *) echo "usage: agent5 worker token create" >&2; return 2 ;;
      esac
      ;;
    quarantine)
      local wid="${1:-}"; shift || true
      local reason="manual"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --reason) reason="$2"; shift 2 ;;
          *) shift ;;
        esac
      done
      [[ -n "$wid" ]] || { echo "usage: agent5 worker quarantine WORKER_ID --reason R" >&2; return 2; }
      WORKER_ID="$wid" REASON="$reason" python3 - <<'PY'
import json, os
from distributed import quarantine
print(json.dumps(quarantine.quarantine(os.environ["WORKER_ID"], reason=os.environ["REASON"]), indent=2))
PY
      ;;
    unquarantine)
      local wid="${1:-}"
      [[ -n "$wid" ]] || { echo "usage: agent5 worker unquarantine WORKER_ID" >&2; return 2; }
      WORKER_ID="$wid" python3 - <<'PY'
import json, os
from distributed import quarantine
print(json.dumps(quarantine.unquarantine(os.environ["WORKER_ID"]), indent=2))
PY
      ;;
    drain)
      local wid="${1:-}"
      [[ -n "$wid" ]] || { echo "usage: agent5 worker drain WORKER_ID" >&2; return 2; }
      WORKER_ID="$wid" python3 - <<'PY'
import json, os
from distributed import quarantine
print(json.dumps(quarantine.drain(os.environ["WORKER_ID"]), indent=2))
PY
      ;;
    label)
      local lsub="${1:-}"; shift || true
      local wid="${1:-}"; local lab="${2:-}"
      case "$lsub" in
        add)
          WORKER_ID="$wid" LABEL="$lab" python3 - <<'PY'
import json, os
from distributed import registry
print(json.dumps(registry.add_label(os.environ["WORKER_ID"], os.environ["LABEL"]), indent=2))
PY
          ;;
        remove)
          WORKER_ID="$wid" LABEL="$lab" python3 - <<'PY'
import json, os
from distributed import registry
print(json.dumps(registry.remove_label(os.environ["WORKER_ID"], os.environ["LABEL"]), indent=2))
PY
          ;;
        *) echo "usage: agent5 worker label add|remove WORKER_ID LABEL" >&2; return 2 ;;
      esac
      ;;
    assign)
      local tid="${1:-}"; shift || true
      local wid="" provider="stub"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --worker) wid="$2"; shift 2 ;;
          --provider) provider="$2"; shift 2 ;;
          *) shift ;;
        esac
      done
      [[ -n "$tid" ]] || { echo "usage: agent5 worker assign TASK_ID [--worker ID]" >&2; return 2; }
      TASK_ID="$tid" WORKER_ID="$wid" PROVIDER="$provider" python3 - <<'PY'
import json, os
from distributed import routing
tid = os.environ["TASK_ID"]
wid = os.environ.get("WORKER_ID") or ""
req = {"preferred_provider": os.environ.get("PROVIDER") or "stub"}
decision = None
if not wid:
    decision = routing.select_worker(task_id=tid, requirements=req)
    wid = decision.worker_id
if not wid:
    raise SystemExit("no eligible worker")
asgn = routing.create_assignment(wid, tid, payload={"mode": "stub"})
out = {"assignment": asgn}
if decision:
    out["decision"] = decision.to_dict()
print(json.dumps(out, indent=2))
PY
      ;;
    failover)
      local mode="${1:-dry-run}"; shift || true
      local wid="${1:-}"; local tid="${2:-}"
      [[ -n "$wid" ]] || { echo "usage: agent5 worker failover dry-run WORKER_ID [TASK_ID]" >&2; return 2; }
      FAILED="$wid" TASK_ID="$tid" python3 - <<'PY'
import json, os
from distributed import failover
print(json.dumps(failover.dry_run(os.environ["FAILED"], task_id=os.environ.get("TASK_ID") or ""), indent=2))
PY
      ;;
    remove)
      local wid="${1:-}"
      [[ -n "$wid" ]] || { echo "usage: agent5 worker remove WORKER_ID" >&2; return 2; }
      WORKER_ID="$wid" python3 - <<'PY'
import json, os
from distributed import registry
print(json.dumps({"ok": registry.remove_worker(os.environ["WORKER_ID"])}, indent=2))
PY
      ;;
    *)
      echo "usage: agent5 worker list|show|token|quarantine|unquarantine|drain|label|assign|failover|remove" >&2
      return 2
      ;;
  esac
}




