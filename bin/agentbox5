  # --- rc1 Control Plane ---
  echo "== rc1 API / Web / WS =="
  PYTHONPATH="${AGENTBOX_V5_LIB}" python3 -c '
import os, sys
from api.app import create_app
from api.auth import ensure_admin_token
from api.deps import load_web_config, is_tailscale_addr
app = create_app()
assert ensure_admin_token()
host = load_web_config().get("server", "host", fallback="")
