cmd_recover() {
  ab5_ensure_env
  # agent5 recover [--dry-run]  OR recovery subcommands via alias
  if [[ "${1:-}" == "scan" || "${1:-}" == "status" || "${1:-}" == "apply" ]]; then
    python3 "${AGENTBOX_V5_LIB}/ops/recovery.py" "$@"
  else
    local dry=0
    for a in "$@"; do [[ "$a" == "--dry-run" ]] && dry=1; done
    if [[ "$dry" -eq 1 ]]; then
      python3 "${AGENTBOX_V5_LIB}/ops/recovery.py" apply --dry-run
    else
      python3 "${AGENTBOX_V5_LIB}/ops/recovery.py" apply
    fi
  fi
}

