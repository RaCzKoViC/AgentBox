      PYTHONPATH="${AGENTBOX_V5_LIB}" python3 -c 'from api.web_runtime import status; print(status().get("url",""))'
      ;;
    *) echo "usage: agent5 web start|stop|restart|status|token|url" >&2; return 2 ;;
  esac
}

cmd_api() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    health)
      local host port token
      host="$(PYTHONPATH="${AGENTBOX_V5_LIB}" python3 -c 'from api.deps import load_web_config; print(load_web_config().get("server","host",fallback="100.123.66.15"))')"
      port="$(PYTHONPATH="${AGENTBOX_V5_LIB}" python3 -c 'from api.deps import load_web_config; print(load_web_config().get("server","port",fallback="8787"))')"
      token="$(python3 "${AGENTBOX_V5_LIB}/api/web_runtime.py" token 2>/dev/null | tail -n1)"
      curl -fsS -H "Authorization: Bearer ${token}" "http://${host}:${port}/api/v1/health"
      echo
      ;;
    *) echo "usage: agent5 api health" >&2; return 2 ;;
  esac
}

cmd_auth() {
