  if [[ -f "$AGENTBOX_V5_HOME/config/agentbox.toml" ]]; then
    sed -i 's/^backend.*/backend = "codex"/' "$AGENTBOX_V5_HOME/config/agentbox.toml" 2>/dev/null || true
