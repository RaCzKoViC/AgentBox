#!/usr/bin/env bash
# AgentBox v5 CLI control plane (5.5.0 — Evaluation + Tools + Planning + Intelligence + Distributed)
set -euo pipefail

# Project root (benchmarks/, docs/)
if [[ -z "${AGENTBOX_V5_ROOT:-}" ]]; then
  if [[ -d /workspace/agentbox-v5 ]]; then
    export AGENTBOX_V5_ROOT=/workspace/agentbox-v5
  elif [[ -d "${HOME}/.local/share/agentbox/v5/benchmarks" ]]; then
    export AGENTBOX_V5_ROOT="${HOME}/.local/share/agentbox/v5"
  fi
fi

VERSION_FILE=""
_resolve_paths() {
  local bin_dir
  bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -d "${HOME}/.local/lib/agentbox5" ]]; then
    export AGENTBOX_V5_LIB="${AGENTBOX_V5_LIB:-$HOME/.local/lib/agentbox5}"
  elif [[ -d "${bin_dir}/../lib" ]]; then
    export AGENTBOX_V5_LIB="${AGENTBOX_V5_LIB:-$(cd "${bin_dir}/../lib" && pwd)}"
  fi
  export AGENTBOX_V5_HOME="${AGENTBOX_V5_HOME:-$HOME/.local/share/agentbox/v5}"
  export AGENTBOX_V5_DB="${AGENTBOX_V5_DB:-$AGENTBOX_V5_HOME/data/agentbox.db}"
  export AGENTBOX_AUTO_APPROVE="${AGENTBOX_AUTO_APPROVE:-1}"

  if [[ -f "${bin_dir}/../VERSION" ]]; then
    VERSION_FILE="${bin_dir}/../VERSION"
  elif [[ -f "${AGENTBOX_V5_LIB}/../VERSION" ]]; then
    VERSION_FILE="${AGENTBOX_V5_LIB}/../VERSION"
  elif [[ -f "$HOME/.local/share/agentbox/v5/VERSION" ]]; then
    VERSION_FILE="$HOME/.local/share/agentbox/v5/VERSION"
  fi
}

_resolve_paths

# shellcheck disable=SC1091
source "${AGENTBOX_V5_LIB}/core/state.sh"
# shellcheck disable=SC1091
source "${AGENTBOX_V5_LIB}/storage/logs.sh" 2>/dev/null || true

usage() {
  cat <<'USAGE'
AgentBox v5.5.0 — CLI (Evaluation + Tools + Planning + Intelligence + Distributed + Ops)

Usage:
  agentbox5 / agent5 version
  agentbox5 status
  agentbox5 init-db
  agentbox5 task create --project PATH --title T [...]
  agentbox5 task list|show|set-status|depend|timeline TASK_ID
  agentbox5 queue | graph show | run list | event list
  agentbox5 policy list|show ID|check ACTION
  agentbox5 budget show|task ID|usage|set ...
  agentbox5 risk check ACTION|history
  agentbox5 approval list|show ID|approve ID|reject ID
  agentbox5 sandbox|memory|context|agent ...
  agentbox5 agent status
  agentbox5 handoff list|show ID|create TASK SRC TGT --reason R [--optional]
  agentbox5 handoff accept|start|complete|fail|reject ID [...]
  agentbox5 metrics
  agentbox5 daemon start|stop|status
  agentbox5 web start|stop|status|token|url
  agentbox5 api health
  agentbox5 auth token rotate|sessions|revoke ID
  agentbox5 backup create|list|inspect|verify|prune|export
  agentbox5 restore list|verify ID|ID
  agentbox5 doctor | diagnostics create
  agentbox5 recover [--dry-run] | recovery scan|status|apply
  agentbox5 maintenance enter|exit|status
  agentbox5 integrity check|full
  agentbox5 retention prune [--dry-run]
  agentbox5 migrate status|run
  agentbox5 upgrade check|plan|apply|status
  agentbox5 rollback plan|apply [ID]
  agentbox5 start|stop|restart   # daemon+web lifecycle
  agentbox5 health
  agentbox5 worker list|show|token|quarantine|unquarantine|drain|assign|failover
  agentbox5 intelligence status|index PROJECT|search Q|router TASK|memory list
  agentbox5 goal create|list|show|plan|progress
  agentbox5 plan create|list|show|graph|revise|validate
  agentbox5 workflow list|show|compile|run
  agentbox5 reflect list|run
  agentbox5 tool list|show|search|run|health|discover
  agentbox5 eval list|run SUITE|show RUN
  agentbox5 benchmark list
  agentbox5 propose list|show|approve|reject
  agentbox5 baseline show [SUITE]
  agentbox5 selftest [--distributed] [--intelligence] [--tools] [--evaluation]

Autonomous: AGENTBOX_AUTO_APPROVE=1 auto-approves non-CRITICAL.
CRITICAL (force_push, privileged docker, /etc writes) still DENY.
Data: ~/.local/share/agentbox/v5/  (does NOT touch v4.9)
USAGE
}

cmd_version() {
  local ver="5.5.0"
  if [[ -n "${VERSION_FILE:-}" && -f "$VERSION_FILE" ]]; then
    ver="$(tr -d '[:space:]' < "$VERSION_FILE")"
  fi
  echo "agentbox5 ${ver}"
}

cmd_init_db() {
  ab5_ensure_env
  local path
  path="$(ab5_db init)"
  echo "Initialized DB: $path"
}

cmd_task() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    create)
      local project="" title="" desc="" provider="" model="" priority="0"
      local budget_tokens="0" budget_cost="0" approval_policy="auto" sandbox_mode="worktree"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --project) project="$2"; shift 2 ;;
          --title) title="$2"; shift 2 ;;
          --desc|--description) desc="$2"; shift 2 ;;
          --provider) provider="$2"; shift 2 ;;
          --model) model="$2"; shift 2 ;;
          --priority) priority="$2"; shift 2 ;;
          --budget-tokens) budget_tokens="$2"; shift 2 ;;
          --budget-cost) budget_cost="$2"; shift 2 ;;
          --approval-policy) approval_policy="$2"; shift 2 ;;
          --sandbox-mode) sandbox_mode="$2"; shift 2 ;;
          *) echo "unknown arg: $1" >&2; return 2 ;;
        esac
      done
      if [[ -z "$project" || -z "$title" ]]; then
        echo "task create requires --project and --title" >&2
        return 2
      fi
      ab5_ensure_env
      ab5_db create-task --project "$project" --title "$title" --desc "$desc" \
        --provider "$provider" --model "$model" --priority "$priority" \
        --budget-tokens "$budget_tokens" --budget-cost "$budget_cost" \
        --approval-policy "$approval_policy" --sandbox-mode "$sandbox_mode"
      ;;
    list)
      local status=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --status) status="$2"; shift 2 ;;
          *) echo "unknown arg: $1" >&2; return 2 ;;
        esac
      done
      ab5_ensure_env
      if [[ -n "$status" ]]; then
        ab5_db list-tasks --status "$status"
      else
        ab5_db list-tasks
      fi
      ;;
    show)
      local id="${1:-}"
      if [[ -z "$id" ]]; then echo "task show ID required" >&2; return 2; fi
      ab5_ensure_env
      ab5_db get-task "$id"
      ;;
    set-status)
      local id="${1:-}" st="${2:-}"
      if [[ -z "$id" || -z "$st" ]]; then
        echo "task set-status ID STATUS" >&2
        return 2
      fi
      ab5_ensure_env
      ab5_db set-status "$id" "$st"
      ;;
    depend)
      local id="${1:-}"; shift || true
      if [[ -z "$id" ]]; then
        echo "task depend ID --on OTHER" >&2
        return 2
      fi
      local ons=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --on) ons+=(--on "$2"); shift 2 ;;
          *) echo "unknown arg: $1" >&2; return 2 ;;
        esac
      done
      if [[ ${#ons[@]} -eq 0 ]]; then
        echo "task depend requires at least one --on" >&2
        return 2
      fi
      ab5_ensure_env
      # shellcheck disable=SC1091
      source "${AGENTBOX_V5_LIB}/core/graph.sh"
      ab5_graph_depend "$id" "${ons[@]}"
      ;;
    timeline)
      local id="${1:-}"
      if [[ -z "$id" ]]; then echo "task timeline TASK_ID" >&2; return 2; fi
      ab5_ensure_env
      python3 "${AGENTBOX_V5_LIB}/observability/timeline.py" "$id" --text
      ;;
    *)
      echo "unknown task subcommand: ${sub:-<none>}" >&2
      return 2
      ;;
  esac
}

cmd_queue() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    ""|list|status)
      ab5_db queue-stats
      echo "--- ready ---"
      ab5_db list-ready --limit 50
      ;;
    add)
      local id="${1:-}"
      if [[ -z "$id" ]]; then
        echo "queue add TASK_ID" >&2
        return 2
      fi
      ab5_db set-status "$id" queued
      ;;
    *)
      echo "queue | queue add TASK_ID" >&2
      return 2
      ;;
  esac
}

cmd_graph() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    show)
      local id="${1:-}"
      if [[ -z "$id" ]]; then echo "graph show TASK_ID" >&2; return 2; fi
      ab5_ensure_env
      # shellcheck disable=SC1091
      source "${AGENTBOX_V5_LIB}/core/graph.sh"
      ab5_graph_show "$id"
      ;;
    *)
      echo "graph show TASK_ID" >&2
      return 2
      ;;
  esac
}

cmd_run() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)
      local task=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --task) task="$2"; shift 2 ;;
          *) echo "unknown arg: $1" >&2; return 2 ;;
        esac
      done
      ab5_ensure_env
      if [[ -n "$task" ]]; then
        ab5_db list-runs --task "$task"
      else
        ab5_db list-runs
      fi
      ;;
    *)
      echo "unknown run subcommand: ${sub:-<none>}" >&2
      return 2
      ;;
  esac
}

cmd_event() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)
      local task="" limit="50"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --task) task="$2"; shift 2 ;;
          --limit) limit="$2"; shift 2 ;;
          *) echo "unknown arg: $1" >&2; return 2 ;;
        esac
      done
      ab5_ensure_env
      if [[ -n "$task" ]]; then
        ab5_db list-events --task "$task" --limit "$limit"
      else
        ab5_db list-events --limit "$limit"
      fi
      ;;
    *)
      echo "unknown event subcommand: ${sub:-<none>}" >&2
      return 2
      ;;
  esac
}

cmd_budget() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    show|"")
      python3 "${AGENTBOX_V5_LIB}/policy/budgets.py" show
      ;;
    task)
      local id="${1:-}"
      if [[ -z "$id" ]]; then echo "budget task ID" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/policy/budgets.py" task "$id"
      ;;
    usage)
      python3 "${AGENTBOX_V5_LIB}/policy/budgets.py" usage "$@"
      ;;
    set)
      local id="${1:-}" kind="${2:-}" val="${3:-}"
      if [[ -z "$id" || -z "$kind" || -z "$val" ]]; then
        echo "budget set ID tokens N | budget set ID cost N" >&2
        return 2
      fi
      python3 "${AGENTBOX_V5_LIB}/policy/budgets.py" set "$id" "$kind" "$val"
      ;;
    *)
      echo "budget show|task ID|usage|set ID tokens|cost N" >&2
      return 2
      ;;
  esac
}

cmd_policy() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    list)
      python3 "${AGENTBOX_V5_LIB}/policy/policies.py" list
      ;;
    show)
      if [[ -n "${1:-}" ]]; then
        python3 "${AGENTBOX_V5_LIB}/policy/policies.py" show "$1"
      else
        python3 "${AGENTBOX_V5_LIB}/policy/policies.py" show
      fi
      ;;
    check)
      local first="${1:-}"; shift || true
      if [[ -z "$first" ]]; then
        echo "policy check ACTION | policy check TASK --action ACTION" >&2
        return 2
      fi
      if [[ "${1:-}" == "--action" ]]; then
        local action="${2:-}"
        python3 "${AGENTBOX_V5_LIB}/policy/policies.py" evaluate "$action" --task "$first"
      else
        python3 "${AGENTBOX_V5_LIB}/policy/policies.py" evaluate "$first" "$@"
      fi
      ;;
    *)
      echo "policy list|show [ID]|check ACTION" >&2
      return 2
      ;;
  esac
}

cmd_approval() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    list)
      python3 "${AGENTBOX_V5_LIB}/policy/approvals.py" list "$@"
      ;;
    show|get)
      local id="${1:-}"
      if [[ -z "$id" ]]; then echo "approval show ID" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/policy/approvals.py" show "$id"
      ;;
    create)
      local tid="${1:-}" gate="${2:-}"
      if [[ -z "$tid" || -z "$gate" ]]; then
        echo "approval create TASK GATE [--reason R]" >&2
        return 2
      fi
      shift 2 || true
      python3 "${AGENTBOX_V5_LIB}/policy/approvals.py" create "$tid" "$gate" "$@"
      ;;
    approve)
      local id="${1:-}"; shift || true
      if [[ -z "$id" ]]; then echo "approval approve ID [--reason R]" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/policy/approvals.py" approve "$id" "$@"
      ;;
    reject)
      local id="${1:-}"; shift || true
      if [[ -z "$id" ]]; then echo "approval reject ID [--reason R]" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/policy/approvals.py" reject "$id" "$@"
      ;;
    *)
      echo "approval list|show ID|create TASK GATE|approve ID|reject ID" >&2
      return 2
      ;;
  esac
}

cmd_risk() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    check)
      local action="${1:-}"; shift || true
      if [[ -z "$action" ]]; then echo "risk check ACTION [--resource R]" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/policy/risk.py" check "$action" "$@"
      ;;
    history)
      python3 "${AGENTBOX_V5_LIB}/policy/risk.py" history "$@"
      ;;
    *)
      echo "risk check ACTION|history" >&2
      return 2
      ;;
  esac
}

cmd_sandbox() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    create)
      local tid="${1:-}"; shift || true
      if [[ -z "$tid" ]]; then echo "sandbox create TASK [--mode M]" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/sandbox/manager.py" create "$tid" "$@"
      ;;
    inspect)
      local tid="${1:-}"
      if [[ -z "$tid" ]]; then echo "sandbox inspect TASK" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/sandbox/manager.py" inspect "$tid"
      ;;
    destroy)
      local tid="${1:-}"
      if [[ -z "$tid" ]]; then echo "sandbox destroy TASK" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/sandbox/manager.py" destroy "$tid"
      ;;
    *)
      echo "sandbox create|inspect|destroy TASK" >&2
      return 2
      ;;
  esac
}


cmd_memory() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    add)
      local scope="" key="" content="" kind="note"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --scope) scope="$2"; shift 2 ;;
          --key) key="$2"; shift 2 ;;
          --content) content="$2"; shift 2 ;;
          --kind) kind="$2"; shift 2 ;;
          *) echo "unknown arg: $1" >&2; return 2 ;;
        esac
      done
      if [[ -z "$scope" || -z "$content" ]]; then
        echo "memory add requires --scope and --content" >&2
        return 2
      fi
      python3 "${AGENTBOX_V5_LIB}/memory/store.py" add --scope "$scope" --key "$key" --content "$content" --kind "$kind"
      ;;
    list)
      local scope="" key=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --scope) scope="$2"; shift 2 ;;
          --key) key="$2"; shift 2 ;;
          *) echo "unknown arg: $1" >&2; return 2 ;;
        esac
      done
      local args=()
      [[ -n "$scope" ]] && args+=(--scope "$scope")
      [[ -n "$key" ]] && args+=(--key "$key")
      python3 "${AGENTBOX_V5_LIB}/memory/store.py" list "${args[@]}"
      ;;
    get)
      local id="${1:-}"
      if [[ -z "$id" ]]; then echo "memory get ID" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/memory/store.py" get "$id"
      ;;
    forget)
      local id="${1:-}"
      if [[ -z "$id" ]]; then echo "memory forget ID" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/memory/store.py" forget "$id"
      ;;
    *)
      echo "memory add|list|get|forget" >&2
      return 2
      ;;
  esac
}

cmd_context() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    build)
      local tid="${1:-}"; shift || true
      if [[ -z "$tid" ]]; then echo "context build TASK_ID [--max-tokens N]" >&2; return 2; fi
      local max_tokens=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --max-tokens) max_tokens="$2"; shift 2 ;;
          *) echo "unknown arg: $1" >&2; return 2 ;;
        esac
      done
      if [[ -n "$max_tokens" ]]; then
        python3 "${AGENTBOX_V5_LIB}/memory/context.py" build "$tid" --max-tokens "$max_tokens"
      else
        python3 "${AGENTBOX_V5_LIB}/memory/context.py" build "$tid"
      fi
      ;;
    *)
      echo "context build TASK_ID [--max-tokens N]" >&2
      return 2
      ;;
  esac
}

cmd_agent() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    register)
      local id="" name="" role="" provider="" model="" status="active"
      local caps=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --id) id="$2"; shift 2 ;;
          --name) name="$2"; shift 2 ;;
          --role) role="$2"; shift 2 ;;
          --provider) provider="$2"; shift 2 ;;
          --model) model="$2"; shift 2 ;;
          --status) status="$2"; shift 2 ;;
          --capability) caps+=(--capability "$2"); shift 2 ;;
          *) echo "unknown arg: $1" >&2; return 2 ;;
        esac
      done
      if [[ -z "$id" || -z "$name" ]]; then
        echo "agent register requires --id and --name" >&2
        return 2
      fi
      python3 "${AGENTBOX_V5_LIB}/agents/registry.py" register \
        --id "$id" --name "$name" --role "$role" --provider "$provider" \
        --model "$model" --status "$status" "${caps[@]}"
      ;;
    list)
      python3 "${AGENTBOX_V5_LIB}/agents/registry.py" list "$@"
      ;;
    show)
      local id="${1:-}"
      if [[ -z "$id" ]]; then echo "agent show ID" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/agents/registry.py" show "$id"
      ;;
    set)
      local id="${1:-}"; shift || true
      if [[ -z "$id" ]]; then echo "agent set ID --status active|disabled" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/agents/registry.py" set "$id" "$@"
      ;;
    status)
      ab5_ensure_env
      python3 - <<'PY'
import json, os, sys
sys.path.insert(0, os.environ["AGENTBOX_V5_LIB"])
from agents.registry import list_agents, load_delegate_matrix
agents = list_agents()
matrix = load_delegate_matrix()
print("== agent status ==")
print(f"registered: {len(agents)}")
by = {}
for a in agents:
    st = a.get("status") or "?"
    by[st] = by.get(st, 0) + 1
    role = a.get("role") or ""
    print(f"  {a.get('id'):<16} role={role:<12} status={st:<10} provider={a.get('provider') or '-'}")
print("by_status:", by)
print("can_delegate edges:")
for src, tgts in sorted(matrix.items()):
    print(f"  {src} → {', '.join(tgts)}")
PY
      ;;
    *)
      echo "agent register|list|show|set|status" >&2
      return 2
      ;;
  esac
}

cmd_daemon() {
  local sub="${1:-}"
  local dbin=""
  if command -v agentboxd >/dev/null 2>&1; then
    dbin="$(command -v agentboxd)"
  elif [[ -x "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/agentboxd" ]]; then
    dbin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/agentboxd"
  else
    echo "agentboxd not found in PATH" >&2
    return 1
  fi
  case "$sub" in
    start|stop|status) exec "$dbin" "$sub" ;;
    *) echo "daemon start|stop|status" >&2; return 2 ;;
  esac
}


_ab5_invoke_runner() {
  # Prefer parent's Codex ab5_run_task; fallback to stub
  if declare -F ab5_run_task >/dev/null 2>&1; then
    ab5_run_task "$@"
  else
    ab5_run_stub "$@"
  fi
}


cmd_status() {
  ab5_ensure_env
  local ver="5.5.0"
  if [[ -n "${VERSION_FILE:-}" && -f "$VERSION_FILE" ]]; then
    ver="$(tr -d '[:space:]' < "$VERSION_FILE")"
  fi
  echo "=== AgentBox ${ver} status ==="
  local dbin=""
  if command -v agentboxd >/dev/null 2>&1; then dbin="$(command -v agentboxd)"
  elif [[ -x "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/agentboxd" ]]; then
    dbin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/agentboxd"
  fi
  if [[ -n "$dbin" ]]; then
    "$dbin" status 2>/dev/null || true
  else
    echo "agentboxd: (not installed)"
  fi
  if [[ -f "$AGENTBOX_V5_DB" ]]; then
    python3 - <<'PY'
import json, os, sys
sys.path.insert(0, os.environ["AGENTBOX_V5_LIB"])
from storage import db as dbmod
from observability.metrics import latest_by_name
stats = dbmod.queue_stats()
print(f"tasks: queued={stats.get('queued',0)} ready={stats.get('ready',0)} running={stats.get('running',0)} completed={stats.get('completed',0)} failed={stats.get('failed',0)}")
try:
    with dbmod.connect() as conn:
        hc = conn.execute("SELECT status, COUNT(*) c FROM agent_handoffs GROUP BY status").fetchall()
        if hc:
            parts = [f"{r['status']}={r['c']}" for r in hc]
            print("handoffs:", " ".join(parts))
        else:
            print("handoffs: (none)")
        ac = conn.execute("SELECT COUNT(*) c FROM agents").fetchone()["c"]
        print(f"agents: registered={ac}")
except Exception as e:
    print(f"handoffs/agents: ({e})")
latest = latest_by_name()
def g(name, default="n/a"):
    r = latest.get(name)
    if not r: return default
    return f"{r['metric_value']:.1f}"
print(f"CPU%={g('resource.cpu_pct')}  RAM%={g('resource.ram_pct')}  load={g('resource.loadavg')}  disk%={g('resource.disk_pct')}")
print(f"queue_depth={g('resource.queue_depth')}  running_tasks={g('resource.running_tasks')}  running_agents={g('resource.running_agents')}")
# beta3: pending approvals + budget warnings
try:
    with dbmod.connect() as conn:
        pending = conn.execute("SELECT COUNT(*) c FROM approvals WHERE status='pending'").fetchone()["c"]
        print(f"approvals_pending={pending}")
        try:
            risks = conn.execute("SELECT COUNT(*) c FROM risk_assessments").fetchone()["c"]
            print(f"risk_assessments={risks}")
        except Exception:
            pass
except Exception as e:
    print(f"approvals: ({e})")
try:
    from policy.budgets import budget_summary
    bs = budget_summary()
    warns = bs.get("warnings") or []
    if warns:
        print("budget_warnings:")
        for w in warns:
            print(f"  {w['metric']}: {w['used']}/{w['limit']} ({w['pct']}%)")
    else:
        print("budget_warnings: (none)")
except Exception as e:
    print(f"budget_warnings: ({e})")
PY
  else
    echo "DB: not initialized"
  fi
  python3 "${AGENTBOX_V5_LIB}/observability/sampler.py" >/dev/null 2>&1 || true
}

cmd_handoff() {
  local sub="${1:-}"; shift || true
  ab5_ensure_env
  case "$sub" in
    list)
      python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" list "$@"
      ;;
    show)
      local id="${1:-}"
      if [[ -z "$id" ]]; then echo "handoff show ID" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" show "$id"
      ;;
    create)
      local task="" src="" tgt="" reason="" optional=0
      if [[ $# -ge 3 && "$1" != --* ]]; then
        task="$1"; src="$2"; tgt="$3"; shift 3
      fi
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --reason) reason="$2"; shift 2 ;;
          --optional) optional=1; shift ;;
          *) echo "unknown arg: $1" >&2; return 2 ;;
        esac
      done
      if [[ -z "$task" || -z "$src" || -z "$tgt" ]]; then
        echo "handoff create TASK SRC TGT --reason R [--optional]" >&2
        return 2
      fi
      if [[ "$optional" -eq 1 ]]; then
        python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" create "$task" "$src" "$tgt" --reason "$reason" --optional
      else
        python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" create "$task" "$src" "$tgt" --reason "$reason"
      fi
      ;;
    accept|start|complete)
      local id="${1:-}"
      if [[ -z "$id" ]]; then echo "handoff $sub ID" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" "$sub" "$id"
      ;;
    fail)
      local id="${1:-}"; shift || true
      local err="${1:-failed}"
      if [[ -z "$id" ]]; then echo "handoff fail ID [error]" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" fail "$id" "$err"
      ;;
    reject)
      local id="${1:-}"; shift || true
      local reason="${1:-rejected}"
      if [[ -z "$id" ]]; then echo "handoff reject ID [reason]" >&2; return 2; fi
      python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" reject "$id" "$reason"
      ;;
    *)
      echo "handoff list|show|create|accept|start|complete|fail|reject" >&2
      return 2
      ;;
  esac
}

cmd_metrics() {
  ab5_ensure_env
  python3 "${AGENTBOX_V5_LIB}/observability/sampler.py" >/dev/null 2>&1 || true
  python3 - <<'PY'
import json, os, sys
sys.path.insert(0, os.environ["AGENTBOX_V5_LIB"])
from observability.metrics import summary, latest_by_name
s = summary()
latest = latest_by_name()
print("== metrics (latest gauges) ==")
for name in sorted(latest.keys()):
    r = latest[name]
    print(f"  {name:<32} {r['metric_value']:<12} @ {str(r.get('created_at',''))[:19]}")
print("== sums (counters) ==")
interesting = [k for k in sorted(s["sums"]) if not k.startswith("resource.")]
for k in interesting:
    print(f"  {k:<32} {s['sums'][k]}")
if not interesting:
    print("  (no counters yet)")
PY
}


