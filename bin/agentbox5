  echo "  [x] migrations framework"
  echo "  [x] recover dry-run"
  echo "  [x] maintenance mode"
  echo "  [x] retention"
  echo "  [x] doctor / security"
  echo "  [x] upgrade/rollback stubs"
  echo "  [x] rc1/beta3 stack intact"

  echo ""
  echo "AgentBox v5.5.0"
  echo ""
  echo "Operations"
  echo "[OK] backups"
  echo "[OK] restore verification"
  echo "[OK] integrity"
  echo "[OK] recovery"
  echo "[OK] maintenance"
  echo "[OK] retention"
  echo "[OK] diagnostics"
  echo ""
  echo "Security"
  echo "[OK] token perms / bind notes / log scan"
  echo ""


  echo "== v5.1 distributed (local loopback worker) =="
  export PYTHONPATH="${AGENTBOX_V5_LIB}${PYTHONPATH:+:$PYTHONPATH}"
  python3 "${AGENTBOX_V5_LIB}/ops/migrations.py" run --no-backup >/dev/null
  DIST_OUT="$(python3 - <<'PY'
import json, platform
from distributed import enrollment, heartbeat, routing, failover, registry
from distributed.capabilities import probe_local
from storage import db as dbmod

tok = enrollment.create_enrollment_token(ttl_minutes=30)
caps = probe_local()
en = enrollment.enroll(
    tok["token"],
    name="selftest-loopback",
    hostname=platform.node(),
    tailscale_ip="127.0.0.1",
    platform=platform.system().lower(),
    architecture=platform.machine(),
    version="5.4.0",
    capabilities=caps,
    labels=["linux", "local", "loopback", "selftest"],
    max_parallel_tasks=2,
    protocol_version=1,
    auto_approve=True,
)
wid = en["worker_id"]
hb = heartbeat.process_heartbeat(wid, cpu_percent=1.0, memory_percent=10.0, active_tasks=0, version="5.4.0", health="healthy")
with dbmod.connect() as conn:
    tid = dbmod.new_id("task_")
    now = dbmod.utc_now()
    conn.execute(
        "INSERT INTO tasks (id, project_id, title, description, status, created_at, updated_at, meta_json) VALUES (?,?,?,?,?,?,?,?)",
        (tid, "/tmp/agentbox5-selftest", "v51-smoke", "distributed smoke", "ready", now, now, "{}"),
    )
    conn.commit()
decision = routing.select_worker(task_id=tid, requirements={"preferred_provider": "stub"})
awid = decision.worker_id or wid
asgn = routing.create_assignment(awid, tid, payload={"mode": "stub"})
routing.accept_assignment(awid, asgn["id"])
routing.complete_assignment(awid, asgn["id"], ok=True, result={"ok": True, "mode": "stub"})
plan = failover.dry_run(awid, task_id=tid)
online = [w for w in registry.list_workers() if w["status"] in ("online", "busy")]
print(json.dumps({
  "worker_id": wid,
  "heartbeat_status": hb.get("status"),
  "online_count": len(online),
  "assignment_id": asgn["id"],
  "assignment_worker": awid,
  "failover_dry_run": plan.get("ok"),
  "failover_action": plan.get("action"),
}))
PY
)"
  echo "$DIST_OUT" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["heartbeat_status"] in ("online","busy"), d; assert d["online_count"]>=1, d; assert d["failover_dry_run"] is True, d; print("OK: distributed enroll+heartbeat+assign+failover")'
  echo "OK: local worker online after selftest enroll"
  cmd_worker list >/dev/null
  echo "OK: worker list"



  # --- v5.2 intelligence ---
  echo "== v5.2: intelligence =="
  local DEMO="${AGENTBOX_DEMO_PYTHON:-/workspace/projects/demo-python}"
  if [[ ! -d "$DEMO" ]]; then
    DEMO="/tmp/agentbox5-demo-python"
    mkdir -p "$DEMO"
    printf '%s\n' 'def add(a, b):' '    """Add two numbers."""' '    return a + b' '' 'def network_connect(host):' '    """Handle network connections."""' '    return f"connected:{host}"' > "$DEMO/main.py"
    printf '%s\n' '# Demo' 'Calculator and network helpers.' > "$DEMO/README.md"
  fi
  python3 "${AGENTBOX_V5_LIB}/ops/migrations.py" run --no-backup >/dev/null
  IDX_OUT="$(python3 "${AGENTBOX_V5_LIB}/intelligence/cli.py" index "$DEMO" --force)"
  echo "$IDX_OUT" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("ok") and d.get("chunks_total",0)>=1, d; print("OK: indexed", d["project_id"], "chunks", d["chunks_total"])'
  local PID
  PID="$(echo "$IDX_OUT" | python3 -c 'import json,sys; print(json.load(sys.stdin)["project_id"])')"
  SEARCH_OUT="$(python3 "${AGENTBOX_V5_LIB}/intelligence/cli.py" search "finite_number calculator add" --project "$PID" --top-k 5)"
  echo "$SEARCH_OUT" | python3 -c 'import json,sys; d=json.load(sys.stdin); hits=d.get("hits") or []; assert hits, d; blob=" ".join((h.get("file_path") or "")+" "+(h.get("symbol") or "")+" "+(h.get("text_preview") or "") for h in hits).lower(); assert ("finite" in blob) or ("add" in blob) or ("main" in blob) or ("calculator" in blob), hits[:3]; print("OK: search hits", len(hits))'
  ROUTER_OUT="$(python3 "${AGENTBOX_V5_LIB}/intelligence/cli.py" router "fix network connection bug in calculator")"
  echo "$ROUTER_OUT" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("provider") and d.get("model"), d; print("OK: router", d["provider"], d["model"])'
  MEM_OUT="$(python3 "${AGENTBOX_V5_LIB}/intelligence/cli.py" memory write "Architecture decision: use pure-Python hash embeddings for local-first indexing")"
  echo "$MEM_OUT" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("id"), d; print("OK: memory write", d["id"])'
  AGENTBOX_V5_LIB="$AGENTBOX_V5_LIB" python3 -c '
import os, sys
sys.path.insert(0, os.environ["AGENTBOX_V5_LIB"])
from intelligence.retrieval import retrieve_context
from intelligence.experience_memory import record_experience
from intelligence.quality_signals import record as qrec
pack = retrieve_context("hash embeddings local-first indexing", top_k=5, sources=["memory","code"])
hits = pack.get("hits") or []
assert hits, pack
print("OK: memory retrieve", len(hits))
record_experience(task_type="bugfix", provider="stub", model="default", outcome="success", notes="selftest")
qrec(provider="stub", model="default", task_type="bugfix", success=True, review_pass=True)
print("OK: experience+quality")
'
  python3 "${AGENTBOX_V5_LIB}/intelligence/cli.py" status >/dev/null
  echo "OK: intelligence status"
  echo "OK: intelligence selftest PASS"


  # --- v5.3 planning ---
  echo "== v5.3: planning =="
  python3 "${AGENTBOX_V5_LIB}/ops/migrations.py" run --no-backup >/dev/null
  python3 "${AGENTBOX_V5_LIB}/planning/cli.py" workflow run software_feature \
    --title "Selftest feature: planning DAG" \
    --description "Build autonomous planning smoke feature" > /tmp/ab53_selftest_plan.json
  python3 -c 'import json; d=json.load(open("/tmp/ab53_selftest_plan.json")); g=d["goal"]; p=d["plan"]; assert g.get("id") and p.get("id") and len(p.get("nodes") or [])>=4; print("OK: goal", g["id"], "plan", p["id"], "nodes", len(p["nodes"])); open("/tmp/ab53_goal","w").write(g["id"]); open("/tmp/ab53_plan","w").write(p["id"])'
  GOAL_ID="$(cat /tmp/ab53_goal)"
  PLAN_ID="$(cat /tmp/ab53_plan)"
  python3 "${AGENTBOX_V5_LIB}/planning/cli.py" plan graph "$PLAN_ID" > /tmp/ab53_selftest_graph.json
  python3 -c 'import json; d=json.load(open("/tmp/ab53_selftest_graph.json")); assert d.get("validation",{}).get("ok") and d.get("ordered_ids"); print("OK: graph ordered", len(d["ordered_ids"]))'
  python3 "${AGENTBOX_V5_LIB}/planning/cli.py" plan revise "$PLAN_ID" --reason "selftest dependency conflict" > /tmp/ab53_selftest_rev.json
  python3 -c 'import json; d=json.load(open("/tmp/ab53_selftest_rev.json")); assert (d.get("plan") or {}).get("id"); ch=d.get("changes") or (d.get("revision") or {}).get("changes") or {}; print("OK: revised", d["plan"]["id"], "added", len(ch.get("added") or [])); open("/tmp/ab53_plan2","w").write(d["plan"]["id"])'
  NEW_PLAN="$(cat /tmp/ab53_plan2)"
  python3 "${AGENTBOX_V5_LIB}/planning/cli.py" reflect run --goal-id "$GOAL_ID" --plan-id "$NEW_PLAN" --status failed --error "dependency incompatible with tests" > /tmp/ab53_selftest_ref.json
  python3 -c 'import json; d=json.load(open("/tmp/ab53_selftest_ref.json")); assert d.get("decision") in ("REPLAN","RETRY","ESCALATE","CONTINUE","COMPLETE"); assert (d.get("reflection") or {}).get("id"); print("OK: reflection", d["decision"], d["reflection"]["id"])'
  python3 "${AGENTBOX_V5_LIB}/planning/cli.py" goal progress "$GOAL_ID" >/dev/null
  echo "OK: planning selftest PASS"

  # --- v5.4 tools ---
  echo "== v5.4: tools =="
  python3 "${AGENTBOX_V5_LIB}/ops/migrations.py" run --no-backup >/dev/null || true
  AGENTBOX_V5_LIB="$AGENTBOX_V5_LIB" python3 - <<'PY'
import os, sys, json, subprocess
from pathlib import Path
sys.path.insert(0, os.environ["AGENTBOX_V5_LIB"])
from tools import registry
from tools.capability import find_tools
from tools.executor import execute_tool
from tools.outcome_memory import list_outcomes
from tools.discovery import discover

disc = discover(register=True)
ids = [t["id"] for t in registry.list_tools()]
assert "git.status" in ids and "shell.run" in ids, ids
print("OK: builtins registered", len(ids))

matches = find_tools("git")
assert matches and any("git" in (m.get("id") or "") for m in matches), matches
print("OK: search git", [m["id"] for m in matches[:5]])

demo = Path("/workspace/projects/demo-python")
if not (demo / ".git").exists():
    subprocess.run(["git", "init"], cwd=str(demo), check=True, capture_output=True)
    subprocess.run(["git", "config", "user.email", "box@agentbox.local"], cwd=str(demo), capture_output=True)
    subprocess.run(["git", "config", "user.name", "box"], cwd=str(demo), capture_output=True)

r = execute_tool("git.status", {"cwd": str(demo), "porcelain": True})
assert r.get("decision") != "deny", r
assert r.get("ok") or r.get("status") == "completed", r
print("OK: git.status", r.get("status"), "exit", r.get("exit_code"))

r2 = execute_tool("shell.run", {"command": "rm -rf /tmp/agentbox-should-not-delete-this-critical", "cwd": "/workspace"})
dec = r2.get("decision") or r2.get("status")
assert (
    r2.get("denied")
    or dec in ("deny", "denied", "awaiting_approval", "approval")
    or r2.get("status") in ("denied", "awaiting_approval")
), r2
print("OK: shell.run dangerous gated", r2.get("status") or dec, "decision", r2.get("decision"))

outs = list_outcomes(limit=20)
assert outs, "expected tool outcomes recorded"
print("OK: outcomes recorded", len(outs))
print("RESULT: PASS")
PY
  echo "OK: tools selftest PASS"


  
  # --- v5.5 evaluation ---
  echo "== v5.5: evaluation =="
  python3 "${AGENTBOX_V5_LIB}/ops/migrations.py" run --no-backup >/dev/null || true
  export AGENTBOX_V5_ROOT="${AGENTBOX_V5_ROOT:-/workspace/agentbox-v5}"
  AGENTBOX_V5_LIB="$AGENTBOX_V5_LIB" AGENTBOX_V5_ROOT="$AGENTBOX_V5_ROOT" python3 - <<'PY'
import os, sys, json
from pathlib import Path
sys.path.insert(0, os.environ["AGENTBOX_V5_LIB"])
root = Path(os.environ.get("AGENTBOX_V5_ROOT", "/workspace/agentbox-v5"))
import evaluation.suites as suites_mod
suites_mod.ROOT = root
suites_mod.BENCHMARKS_ROOT = root / "benchmarks"

from evaluation.suites import list_suites, sync_suites_to_db
from evaluation.harness import run_suite
from evaluation.proposals import list_proposals, approve, reject, create_proposal
from evaluation.failure_mining import propose_from_failures, mine_failures
from evaluation.baselines import get_baseline
from evaluation.ab_test import assign_variant
from evaluation.prompt_versioning import create_version as create_prompt
from evaluation.workflow_versioning import create_version as create_wf

sync = sync_suites_to_db()
print("OK: suites synced", sync)
suites = list_suites()
assert any(s["id"] == "golden" for s in suites), suites
golden = next(s for s in suites if s["id"] == "golden")
assert len(golden.get("cases") or []) >= 3, golden
print("OK: golden cases", len(golden["cases"]))

result = run_suite("golden", set_as_baseline=True)
assert result["status"] == "passed", result
assert result["gate"]["passed"], result["gate"]
assert result["summary"]["passed"] >= 3, result["summary"]
print("OK: golden suite PASS", result["run_id"], "score", result["score"])
bl = get_baseline("golden")
assert bl and bl.get("summary"), bl
print("OK: baseline set", bl["id"])

from evaluation import store
from storage import db as dbmod
with dbmod.connect() as conn:
    store.ensure_schema(conn)
    rid = dbmod.new_id("erun_")
    store.insert_run(conn, {"id": rid, "suite_id": "golden", "status": "failed", "score": 0.0,
                            "started_at": dbmod.utc_now(), "created_at": dbmod.utc_now()})
    for i in range(3):
        store.insert_result(conn, {
            "id": dbmod.new_id("eres_"),
            "evaluation_run_id": rid,
            "case_id": "golden.memory_retrieval",
            "success": False,
            "scores": {"correctness": 0},
            "metrics": {},
            "artifacts": {},
            "error": "synthetic failure: missing context window overflow",
        })
    conn.commit()

mined = mine_failures()
assert mined["cluster_count"] >= 1, mined
props = propose_from_failures(min_count=1)
assert props, props
pid = props[0]["id"]
print("OK: proposal from mining", pid, props[0]["status"])

rj = reject(pid, reason="selftest-reject")
assert rj["status"] == "rejected", rj
print("OK: propose reject")

p2 = create_proposal(
    target_type="case",
    target_id="golden.memory_retrieval",
    proposal={"title": "selftest approve", "change": "noop acknowledge"},
    evidence={"selftest": True},
    risk_level="LOW",
    status="awaiting_approval",
)
ap = approve(p2["id"], apply=True)
assert ap["status"] in ("approved", "promoted"), ap
print("OK: propose approve", ap["status"], "applied", ap.get("applied"))

pv = create_prompt("coder", "You are a careful coder. Write tests first.", status="draft")
assert pv["version"] >= 1
wv = create_wf("software_feature", {"stages": ["intake", "implement", "test"]}, status="draft")
assert wv["version"] >= 1
v = assign_variant("task-abc", ["A", "B"])
assert v in ("A", "B")
print("OK: prompt/workflow versioning + ab stub", pv["id"], wv["id"], v)
print("RESULT: PASS")
PY
  echo "OK: evaluation selftest PASS"


  echo "RESULT: PASS"
  echo "OK: selftest PASS (v5.5 evaluation; v5.4 tools; v5.3 planning; v5.2 intelligence; v5.1 distributed; stable Ops; rc1 API/WS/Dashboard; beta3 Policy; beta2 Handoffs; beta1 memory)"
}



main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    version|-V|--version) cmd_version ;;
    status) cmd_status ;;
    init-db) cmd_init_db ;;
    task) cmd_task "$@" ;;
    queue) cmd_queue "$@" ;;
    graph) cmd_graph "$@" ;;
    run) cmd_run "$@" ;;
    event) cmd_event "$@" ;;
    budget) cmd_budget "$@" ;;
    policy) cmd_policy "$@" ;;
    risk) cmd_risk "$@" ;;
    approval) cmd_approval "$@" ;;
    sandbox) cmd_sandbox "$@" ;;
    memory) cmd_memory "$@" ;;
    context) cmd_context "$@" ;;
    agent) cmd_agent "$@" ;;
    handoff) cmd_handoff "$@" ;;
    metrics) cmd_metrics ;;
    daemon) cmd_daemon "$@" ;;
    web) cmd_web "$@" ;;
    api) cmd_api "$@" ;;
    auth) cmd_auth "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    doctor) cmd_doctor ;;
    diagnostics) cmd_diagnostics "$@" ;;
    recover) cmd_recover "$@" ;;
    recovery) cmd_recovery "$@" ;;
    maintenance) cmd_maintenance "$@" ;;
    integrity) cmd_integrity "$@" ;;
    retention) cmd_retention "$@" ;;
    migrate) cmd_migrate "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    rollback) cmd_rollback "$@" ;;
    lifecycle) cmd_lifecycle "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    health) cmd_health ;;
    worktree) cmd_worktree "$@" ;;
    worker) cmd_worker "$@" ;;
    intelligence) cmd_intelligence "$@" ;;
    tool) cmd_tool "$@" ;;
    eval) cmd_eval "$@" ;;
    benchmark) cmd_benchmark "$@" ;;
    propose) cmd_propose "$@" ;;
    baseline) cmd_baseline "$@" ;;
    goal) cmd_goal "$@" ;;
    plan) cmd_plan "$@" ;;
    workflow) cmd_workflow "$@" ;;
    reflect) cmd_reflect "$@" ;;
    selftest) cmd_selftest "$@" ;;
    help|-h|--help|"") usage ;;
    *) echo "unknown command: $cmd" >&2; usage; return 2 ;;
  esac
}

main "$@"
