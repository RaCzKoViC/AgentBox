cmd_selftest() {
  echo "== agentbox5 selftest (5.5.0 Evaluation + Tools + Planning + Intelligence + Distributed + Stable) =="
  export AGENTBOX_AUTO_APPROVE=1
  # Fast path: stub runner for Safety selftest (Codex exercised separately by parent)
  export AGENTBOX_V5_RUNNER="${AGENTBOX_V5_RUNNER:-stub}"
  cmd_version
  ab5_ensure_env
  mkdir -p "$AGENTBOX_V5_HOME/config"
  local src_cfg
  src_cfg="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/config"
  if [[ -d "$src_cfg" ]]; then
    cp -f "$src_cfg/budgets.toml" "$AGENTBOX_V5_HOME/config/" 2>/dev/null || true
    cp -f "$src_cfg/policies.toml" "$AGENTBOX_V5_HOME/config/" 2>/dev/null || true
    cp -f "$src_cfg/agentbox.toml" "$AGENTBOX_V5_HOME/config/" 2>/dev/null || true
    cp -f "$src_cfg/memory.toml" "$AGENTBOX_V5_HOME/config/" 2>/dev/null || true
    cp -f "$src_cfg/agents.toml" "$AGENTBOX_V5_HOME/config/" 2>/dev/null || true
    mkdir -p "$HOME/.config/agentbox-v5"
    if [[ -f "$src_cfg/policies.ini" ]]; then
      cp -f "$src_cfg/policies.ini" "$HOME/.config/agentbox-v5/policies.ini"
    fi
    for ini in recovery.ini backup.ini; do
      if [[ -f "$src_cfg/$ini" ]]; then
        cp -f "$src_cfg/$ini" "$HOME/.config/agentbox-v5/$ini"
        cp -f "$src_cfg/$ini" "$AGENTBOX_V5_HOME/config/$ini" 2>/dev/null || true
      fi
    done
  fi
  mkdir -p "$AGENTBOX_V5_HOME/memory"
  # Force stub backend in this HOME for selftest speed
  if grep -q '^\[runner\]' "$AGENTBOX_V5_HOME/config/agentbox.toml" 2>/dev/null; then
    if grep -q '^backend' "$AGENTBOX_V5_HOME/config/agentbox.toml"; then
      sed -i 's/^backend.*/backend = "stub"/' "$AGENTBOX_V5_HOME/config/agentbox.toml"
    else
      printf '\nbackend = "stub"\n' >> "$AGENTBOX_V5_HOME/config/agentbox.toml"
    fi
  fi
  echo "HOME=$AGENTBOX_V5_HOME"
  echo "DB=$AGENTBOX_V5_DB"
  echo "LIB=$AGENTBOX_V5_LIB"
  echo "AUTO_APPROVE=$AGENTBOX_AUTO_APPROVE"
  echo "RUNNER=$AGENTBOX_V5_RUNNER"
  cmd_init_db

  local proj="/tmp/agentbox5-selftest"
  mkdir -p "$proj"

  # --- 1) Budget smoke via budgets.py (non-blocking for codex; enforced in module CLI) ---
  echo "== smoke: budget max_tokens=1 =="
  local bout bid bstatus
  bout="$(ab5_db create-task --project "$proj" --title "budget-smoke" --budget-tokens 1 --priority 1)"
  bid="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$bout")"
  if python3 "${AGENTBOX_V5_LIB}/policy/budgets.py" check "$bid" >/dev/null 2>&1; then
    echo "FAIL: budget check should fail for max_tokens=1 vs stub cost" >&2
    return 1
  fi
  python3 "${AGENTBOX_V5_LIB}/policy/budgets.py" pause "$bid" "selftest: would exceed tokens" >/dev/null
  bstatus="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])' \
    <<<"$(ab5_db get-task "$bid")")"
  echo "budget task status=$bstatus"
  [[ "$bstatus" == "paused_budget" || "$bstatus" == "budget_paused" ]] || {
    echo "FAIL: expected paused_budget got $bstatus" >&2
    return 1
  }
  # event budget.exceeded
  python3 -c 'import json,sys,os
sys.path.insert(0, os.environ["AGENTBOX_V5_LIB"]+"/storage")
import db
ev=db.list_events(task_id=sys.argv[1], limit=20)
assert any(e["kind"]=="budget.exceeded" for e in ev), ev
print("OK: budget.exceeded event")
' "$bid"
  echo "OK: budget enforcement ($bid)"

  # --- 2) policy force_push deny / merge approval (raw) ---
  echo "== smoke: policy git.force_push deny =="
  local pdec
  pdec="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["decision"])' \
    <<<"$(python3 "${AGENTBOX_V5_LIB}/policy/policies.py" check git.force_push)")"
  [[ "$pdec" == "deny" ]] || { echo "FAIL: force_push decision=$pdec" >&2; return 1; }
  pdec="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["decision"])' \
    <<<"$(python3 "${AGENTBOX_V5_LIB}/policy/policies.py" check git.merge)")"
  [[ "$pdec" == "approval" || "$pdec" == "allow" ]] || { echo "FAIL: merge got $pdec" >&2; return 1; }
  echo "OK: policy force_push=deny merge=$pdec"

  # --- 3) approval create → approve → stub run ---
  echo "== smoke: approval create/approve =="
  local aout aid appr_id
  aout="$(ab5_db create-task --project "$proj" --title "approval-smoke" --priority 5)"
  aid="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$aout")"
  local aj
  aj="$(AGENTBOX_AUTO_APPROVE=0 python3 "${AGENTBOX_V5_LIB}/policy/approvals.py" create "$aid" before_run --reason "selftest")"
  appr_id="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$aj")"
  local ast
  ast="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])' <<<"$(ab5_db get-task "$aid")")"
  [[ "$ast" == "awaiting_approval" ]] || { echo "FAIL: expected awaiting_approval got $ast" >&2; return 1; }
  python3 "${AGENTBOX_V5_LIB}/policy/approvals.py" approve "$appr_id" --reason "selftest-ok" >/dev/null
  ast="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])' <<<"$(ab5_db get-task "$aid")")"
  [[ "$ast" == "queued" ]] || { echo "FAIL: after approve expected queued got $ast" >&2; return 1; }
  # shellcheck disable=SC1091
  source "${AGENTBOX_V5_LIB}/core/runner.sh"
  AGENTBOX_V5_RUNNER=stub ab5_run_stub "$aid" "selftest-appr" >/dev/null
  ast="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])' <<<"$(ab5_db get-task "$aid")")"
  [[ "$ast" == "completed" ]] || { echo "FAIL: expected completed got $ast" >&2; return 1; }
  echo "OK: approval gate ($appr_id → completed)"

  # --- 4) sandbox worktree demo-python ---
  echo "== smoke: sandbox worktree demo-python =="
  local demo="/workspace/projects/demo-python"
  if [[ ! -d "$demo/.git" ]]; then
    echo "WARN: $demo not a git repo — creating temp git project"
    demo="$(mktemp -d)/demo-python"
    mkdir -p "$demo"
    git -C "$demo" init -q
    echo "print('hi')" > "$demo/main.py"
    git -C "$demo" add -A && git -C "$demo" -c user.email=t@t -c user.name=t commit -qm init
  fi
  local sout sid
  sout="$(ab5_db create-task --project "$demo" --title "sandbox-smoke" --sandbox-mode worktree)"
  sid="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$sout")"
  python3 "${AGENTBOX_V5_LIB}/sandbox/manager.py" create "$sid" --mode worktree \
    | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("path"), d; print("path", d["path"])'
  python3 "${AGENTBOX_V5_LIB}/sandbox/manager.py" destroy "$sid" >/dev/null
  echo "OK: sandbox worktree ($sid)"

  # --- 5) autonomous bypass: approval_policy=always must complete under AUTO_APPROVE ---
  echo "== smoke: autonomous bypass =="
  local tout tid tstatus
  tout="$(ab5_db create-task --project "$proj" --title "auto-always" --approval-policy always)"
  tid="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$tout")"
  ab5_db set-status "$tid" queued >/dev/null
  local gate
  gate="$(python3 "${AGENTBOX_V5_LIB}/policy/approvals.py" ensure-gate "$tid")"
  python3 -c 'import json,sys; d=json.load(sys.stdin); assert not d.get("denied") and d.get("status")!="pending", d' <<<"$gate"
  AGENTBOX_V5_RUNNER=stub ab5_run_stub "$tid" "selftest-auto" >/dev/null
  tstatus="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])' <<<"$(ab5_db get-task "$tid")")"
  [[ "$tstatus" == "completed" ]] || { echo "FAIL: autonomous expected completed got $tstatus" >&2; return 1; }
  echo "OK: autonomous bypass ($tid)"

  # --- 6) deps + daemon with stub ---
  echo "== regression: deps + daemon (stub) =="
  if [[ ! -f "$AGENTBOX_V5_HOME/config/agentbox.toml" ]]; then
    cat > "$AGENTBOX_V5_HOME/config/agentbox.toml" <<'TOML'
[scheduler]
max_workers = 2
[core]
auto_approve = true
[runner]
backend = "stub"
TOML
  fi
  local a_json b_json c_json xa xb xc
  a_json="$(ab5_db create-task --project "$proj" --title "dep-A" --priority 10)"
  b_json="$(ab5_db create-task --project "$proj" --title "dep-B" --priority 10)"
  c_json="$(ab5_db create-task --project "$proj" --title "dep-C" --priority 5)"
  xa="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$a_json")"
  xb="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$b_json")"
  xc="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$c_json")"
  ab5_db add-depends "$xc" --on "$xa" --on "$xb" >/dev/null
  if ab5_db add-depends "$xa" --on "$xc" >/dev/null 2>&1; then
    echo "FAIL: cycle was not blocked" >&2; return 1
  fi
  ab5_db set-status "$xa" queued >/dev/null
  ab5_db set-status "$xb" queued >/dev/null
  ab5_db set-status "$xc" queued >/dev/null

  local dbin
  if [[ -x "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/agentboxd" ]]; then
    dbin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/agentboxd"
  else
    dbin="$(command -v agentboxd)"
  fi
  "$dbin" stop >/dev/null 2>&1 || true
  AGENTBOX_AUTO_APPROVE=1 AGENTBOX_V5_RUNNER=stub "$dbin" start
  local i sa sb sc
  for i in $(seq 1 50); do
    sa="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])' <<<"$(ab5_db get-task "$xa")")"
    sb="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])' <<<"$(ab5_db get-task "$xb")")"
    sc="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])' <<<"$(ab5_db get-task "$xc")")"
    if [[ "$sa" == "completed" && "$sb" == "completed" && "$sc" == "completed" ]]; then
      break
    fi
    sleep 0.4
  done
  "$dbin" stop >/dev/null 2>&1 || true
  echo "final statuses: A=$sa B=$sb C=$sc"
  [[ "$sa" == "completed" && "$sb" == "completed" && "$sc" == "completed" ]] \
    || { echo "FAIL: expected all completed" >&2; return 1; }
  echo "OK: deps + parallel daemon"

  # --- 7) beta1: memory add/list/forget (user + task) ---
  echo "== beta1: memory user+task =="
  local mout mid mlist
  mout="$(python3 "${AGENTBOX_V5_LIB}/memory/store.py" add --scope user --key default --content "prefers python" --kind preference)"
  mid="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$mout")"
  [[ -n "$mid" ]] || { echo "FAIL: memory add returned empty id" >&2; return 1; }
  mlist="$(python3 "${AGENTBOX_V5_LIB}/memory/store.py" list --scope user)"
  python3 -c 'import json,sys; rows=json.load(sys.stdin); assert any(r["id"]==sys.argv[1] for r in rows), rows' <<<"$mlist" "$mid"
  # task-scoped memory tied to demo task
  local demot dout did
  dout="$(ab5_db create-task --project "$proj" --title "context-demo" --desc "demo for context builder")"
  did="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$dout")"
  mout="$(python3 "${AGENTBOX_V5_LIB}/memory/store.py" add --scope task --key "$did" --content "focus on unit tests" --kind note)"
  local tmid
  tmid="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$mout")"
  mlist="$(python3 "${AGENTBOX_V5_LIB}/memory/store.py" list --scope task --key "$did")"
  python3 -c 'import json,sys; rows=json.load(sys.stdin); assert any(r["id"]==sys.argv[1] for r in rows), rows' <<<"$mlist" "$tmid"
  python3 "${AGENTBOX_V5_LIB}/memory/store.py" forget "$tmid" >/dev/null
  mlist="$(python3 "${AGENTBOX_V5_LIB}/memory/store.py" list --scope task --key "$did")"
  python3 -c 'import json,sys; rows=json.load(sys.stdin); assert all(r["id"]!=sys.argv[1] for r in rows), rows' <<<"$mlist" "$tmid"
  echo "OK: memory add/list/forget ($mid user, $tmid forgotten)"

  # --- 8) beta1: context build non-empty ---
  echo "== beta1: context build =="
  # re-add a task note so context has memory content
  python3 "${AGENTBOX_V5_LIB}/memory/store.py" add --scope task --key "$did" --content "ship beta1" --kind note >/dev/null
  local ctx
  ctx="$(python3 "${AGENTBOX_V5_LIB}/memory/context.py" build "$did" --max-tokens 1500)"
  python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("text"), d; assert len(d["text"])>20, d; assert d.get("tokens_est",0)>0, d; print("tokens_est", d["tokens_est"])' <<<"$ctx"
  echo "OK: context build ($did)"

  # --- 9) beta1: agent register + list ---
  echo "== beta1: agent registry =="
  python3 "${AGENTBOX_V5_LIB}/agents/registry.py" register \
    --id coder-1 --name "Coder One" --role coder --provider codex --model gpt-5 >/dev/null
  local agents
  agents="$(python3 "${AGENTBOX_V5_LIB}/agents/registry.py" list)"
  python3 -c 'import json,sys; rows=json.load(sys.stdin); assert any(r["id"]=="coder-1" for r in rows), rows' <<<"$agents"
  python3 "${AGENTBOX_V5_LIB}/agents/registry.py" set coder-1 --status active >/dev/null
  local ag
  ag="$(python3 "${AGENTBOX_V5_LIB}/agents/registry.py" show coder-1)"
  python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["status"]=="active" and d.get("role")=="coder", d' <<<"$ag"
  echo "OK: agent register+list (coder-1)"

  # --- 10) beta2: handoff smoke planner→researcher → accept → complete → artifact → timeline ---
  echo "== beta2: handoff + artifact + timeline =="
  python3 "${AGENTBOX_V5_LIB}/agents/registry.py" seed >/dev/null
  python3 "${AGENTBOX_V5_LIB}/agents/registry.py" register --id planner --name Planner --role planner >/dev/null
  python3 "${AGENTBOX_V5_LIB}/agents/registry.py" register --id researcher --name Researcher --role researcher >/dev/null
  local hout hid
  hout="$(ab5_db create-task --project "$proj" --title "handoff-smoke" --desc "beta2 handoff selftest")"
  hid="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$hout")"
  python3 "${AGENTBOX_V5_LIB}/memory/store.py" add --scope task --key "$hid" --content "research APIs" --kind note >/dev/null
  local hf
  hf="$(python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" create "$hid" planner researcher --reason "need research")"
  local hfid
  hfid="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$hf")"
  python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" accept "$hfid" >/dev/null
  python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" start "$hfid" >/dev/null
  python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" complete "$hfid" --result '{"ok":true,"notes":"selftest"}' >/dev/null
  local hst
  hst="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])' \
    <<<"$(python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" show "$hfid")")"
  [[ "$hst" == "completed" ]] || { echo "FAIL: handoff status=$hst" >&2; return 1; }
  if python3 "${AGENTBOX_V5_LIB}/handoffs/engine.py" create "$hid" tester planner --reason "bad" >/dev/null 2>&1; then
    echo "FAIL: random delegation tester→planner should be DENIED" >&2
    return 1
  fi
  echo "OK: can_delegate deny (tester→planner)"
  python3 "${AGENTBOX_V5_LIB}/artifacts/store.py" write "$hid" --agent researcher --name findings.md --content "# findings\nselftest ok" >/dev/null
  local arts
  arts="$(python3 "${AGENTBOX_V5_LIB}/artifacts/store.py" list --task "$hid")"
  python3 -c 'import json,sys; rows=json.load(sys.stdin); assert rows, rows' <<<"$arts"
  python3 -c "
import os, sys
sys.path.insert(0, os.environ['AGENTBOX_V5_LIB'])
from observability.timeline import timeline
ev = timeline('$hid', limit=100)
kinds = [e['kind'] for e in ev]
assert any(k.startswith('handoff.') for k in kinds), kinds
assert 'handoff.created' in kinds and 'handoff.completed' in kinds, kinds
print('timeline events:', len(ev), 'kinds sample:', kinds[-6:])
"
  python3 "${AGENTBOX_V5_LIB}/observability/sampler.py" >/dev/null
  python3 -c "
import os, sys
sys.path.insert(0, os.environ['AGENTBOX_V5_LIB'])
from observability.metrics import list_metrics, latest_by_name
assert list_metrics(limit=5), 'no metrics'
latest = latest_by_name()
assert any(k.startswith('resource.') for k in latest), list(latest.keys())
print('OK: sampler metrics present')
"
  echo "OK: beta2 handoff smoke ($hfid) + artifact + timeline"

  echo "== beta2 checklist =="
  echo "  [x] schema: agent_handoffs / metrics / agent_runs / artifacts"
  echo "  [x] handoff engine create/accept/start/complete"
  echo "  [x] can_delegate matrix enforced"
  echo "  [x] artifacts store"
  echo "  [x] timeline + metrics sampler"
  echo "  [x] beta1 memory/context/agent intact"
  echo "  [x] alpha3 safety intact"

  # --- 11) Codex runner still present ---
  if ! grep -q 'ab5_run_codex' "${AGENTBOX_V5_LIB}/core/runner.sh"; then
    echo "FAIL: ab5_run_codex missing from runner.sh" >&2
    return 1
  fi
  echo "OK: Codex runner present (ab5_run_codex)"

  # --- 12) beta3: risk / policy / budget / enforcement ---
  echo "== beta3: policy/budget/risk/enforcement =="
  python3 "${AGENTBOX_V5_LIB}/policy/policies.py" seed >/dev/null
  python3 "${AGENTBOX_V5_LIB}/policy/budgets.py" seed >/dev/null

  # Smoke A: workspace write allow
  enf="$(python3 "${AGENTBOX_V5_LIB}/policy/enforcement.py" check filesystem.write --resource /workspace/x.py --agent coder || true)"
  python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["decision"]=="allow", d' <<<"$enf"
  echo "OK: smoke A workspace write allow"

  # Smoke C: force push deny CRITICAL
  enf="$(python3 "${AGENTBOX_V5_LIB}/policy/enforcement.py" check git.force_push --agent coder --force || true)"
  python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["decision"]=="deny", d; assert d["risk"]["risk_level"]=="CRITICAL", d' <<<"$enf"
  echo "OK: smoke C force_push deny"

  # Smoke B: git push gated when AUTO_APPROVE=0
  enf="$(AGENTBOX_AUTO_APPROVE=0 python3 "${AGENTBOX_V5_LIB}/policy/enforcement.py" check git.push --agent coder --task "$hid" || true)"
  python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["decision"] in ("approval","deny","allow"), d; print("push decision", d["decision"])' <<<"$enf"
  echo "OK: smoke B git.push gated"

  # Smoke D: max_handoffs budget exceeded -> pause
  python3 -c "
import os, sys
sys.path.insert(0, os.environ['AGENTBOX_V5_LIB'])
from storage import db as dbmod
from policy.budgets import check_budget, record_usage, pause_budget
tid = '$hid'
for i in range(10):
    record_usage('task', tid, 'max_handoffs', 1.0, task_id=tid)
chk = check_budget('task', tid, 'max_handoffs', 1.0)
assert not chk['ok'], chk
pause_budget(tid, 'selftest max_handoffs')
t = dbmod.get_task(tid)
assert t['status'] in ('budget_paused', 'paused_budget'), t['status']
print('OK: smoke D budget_paused', t['status'])
"

  # Smoke E: system write deny
  enf="$(python3 "${AGENTBOX_V5_LIB}/policy/enforcement.py" check filesystem.system_write --resource /etc/passwd --agent coder || true)"
  python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["decision"]=="deny", d' <<<"$enf"
  echo "OK: smoke E system write deny"

  python3 "${AGENTBOX_V5_LIB}/policy/risk.py" history --limit 5 >/dev/null
  python3 -c "
import os, sys
sys.path.insert(0, os.environ['AGENTBOX_V5_LIB'])
from storage import db as dbmod
with dbmod.connect() as conn:
