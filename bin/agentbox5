      python3 "${AGENTBOX_V5_LIB}/api/web_runtime.py" stop || true
      python3 "${AGENTBOX_V5_LIB}/api/web_runtime.py" start
      ;;
    status) python3 "${AGENTBOX_V5_LIB}/api/web_runtime.py" status ;;
    token) python3 "${AGENTBOX_V5_LIB}/api/web_runtime.py" token ;;
