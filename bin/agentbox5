print("OK: integrity + migrations", st.get("applied"))
'
  local bout_id
  bout_id="$(python3 "${AGENTBOX_V5_LIB}/ops/backups.py" create "selftest" | python3 -c 'import json,sys; print(json.load(sys.stdin)["backup_id"])')"
  [[ -n "$bout_id" ]] || { echo "FAIL: backup create"; return 1; }
  python3 "${AGENTBOX_V5_LIB}/ops/backups.py" verify "$bout_id" >/dev/null || { echo "FAIL: backup verify"; return 1; }
